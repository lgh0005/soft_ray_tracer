const uint INVALID_INDEX = 0xffffffffu;
const uint MESH_TYPE_SKINNED = 1u;
const uint LIGHT_RECT_AREA = 3u;
const float SHADOW_BIAS = 0.0001;
const float SHADOW_T_MIN = 0.000001;
const float MAX_RAY_DISTANCE = 3.402823466e+38;

const float PI = 3.14159265359;
const float EPSILON = 0.0001;
const uint LIGHT_DIRECTIONAL = 0u;
const uint LIGHT_POINT = 1u;
const uint LIGHT_SPOT = 2u;

// GGX Normal Distribution
//[수정] GGX / Smith / Schlick 기반 직접광 BRDF
float DistributionGGX(vec3 N, vec3 H, float roughness)
{
    float safeRoughness = clamp(roughness, 0.045, 1.0);
    float a = safeRoughness * safeRoughness;
    float a2 = a * a;
    float NdotH = clamp(dot(N, H), 0.0, 1.0);
    float NdotH2 = NdotH * NdotH;
    float numerator = a2;
    //[수정] Cross-product sin² preserves small GGX angles without subtracting nearly equal floats.
    float denominator = dot(cross(N, H), cross(N, H)) + a2 * NdotH2;
    return numerator / (PI * denominator * denominator);
}

// Schlick-GGX Geometry
float GeometrySchlickGGX(float NdotV, float roughness)
{
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotV / max(NdotV * (1.0 - k) + k, EPSILON);
}

// Smith Geometry
float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    return GeometrySchlickGGX(NdotV, roughness)
         * GeometrySchlickGGX(NdotL, roughness);
}

// Schlick Fresnel
vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (1.0 - F0) * pow(1.0 - clamp(cosTheta, 0.0, 1.0), 5.0);
}

// Point / Spot 거리 감쇠
float CalculateAttenuation(LightData light, float distance)
{
    if (distance >= light.range)
        return 0.0;

    float denominator =
        light.attenuationConstant +
        light.attenuationLinear * distance +
        light.attenuationQuadratic * distance * distance;

    float attenuation = 1.0 / max(denominator, EPSILON);

    float rangeFactor = clamp
    (
        1.0 - distance / max(light.range, EPSILON),
        0.0,
        1.0
    );

    return attenuation * rangeFactor * rangeFactor;
}

// Opaque, double-sided any-hit traversal. Packed node/primitive offsets are absolute.
struct ShadowRayData
{
    vec3 origin;
    vec3 inverseDirection;
    bvec3 parallel;
};

ShadowRayData PrepareShadowRay(vec3 origin, vec3 direction)
{
    ShadowRayData ray;
    ray.origin = origin;
    ray.parallel = equal(direction, vec3(0.0));
    // Reuse the reciprocal for every node in this TLAS/BLAS traversal.
    ray.inverseDirection = 1.0 / mix(direction, vec3(1.0), ray.parallel);
    return ray;
}

bool IntersectShadowAABB(ShadowRayData ray, GPUBVHNodeBounds bounds, float tMin, float tMax)
{
    bvec3 outside = bvec3(ray.origin.x < bounds.aabbMin.x || ray.origin.x > bounds.aabbMax.x,
        ray.origin.y < bounds.aabbMin.y || ray.origin.y > bounds.aabbMax.y,
        ray.origin.z < bounds.aabbMin.z || ray.origin.z > bounds.aabbMax.z);
    if (any(bvec3(ray.parallel.x && outside.x, ray.parallel.y && outside.y, ray.parallel.z && outside.z))) return false;
    vec3 t0 = (bounds.aabbMin.xyz - ray.origin) * ray.inverseDirection;
    vec3 t1 = (bounds.aabbMax.xyz - ray.origin) * ray.inverseDirection;
    vec3 nearT = mix(min(t0, t1), vec3(-MAX_RAY_DISTANCE), ray.parallel);
    vec3 farT = mix(max(t0, t1), vec3(MAX_RAY_DISTANCE), ray.parallel);
    return max(tMin, max(nearT.x, max(nearT.y, nearT.z))) <= min(tMax, min(farT.x, min(farT.y, farT.z)));
}

bool IntersectShadowTriangle(vec3 origin, vec3 direction, vec3 v0, vec3 v1, vec3 v2, float tMin, float tMax)
{
    vec3 edge1 = v1 - v0;
    vec3 edge2 = v2 - v0;
    vec3 p = cross(direction, edge2);
    float determinant = dot(edge1, p);
    if (abs(determinant) < 1e-6) return false;
    float inverseDeterminant = 1.0 / determinant;
    vec3 offset = origin - v0;
    float u = dot(offset, p) * inverseDeterminant;
    if (u < 0.0 || u > 1.0) return false;
    vec3 q = cross(offset, edge1);
    float v = dot(direction, q) * inverseDeterminant;
    if (v < 0.0 || u + v > 1.0) return false;
    float t = dot(edge2, q) * inverseDeterminant;
    return t > tMin && t < tMax;
}

uint GetShadowNodeEnd(GPUBVHDescriptor descriptor)
{
    // Validate the descriptor once rather than repeating its range arithmetic at every node.
    uint available = uint(bvhTopology.length());
    if (descriptor.ranges.x > available || descriptor.ranges.y > available - descriptor.ranges.x) return 0u;
    return descriptor.ranges.x + descriptor.ranges.y;
}

uint NextShadowNode(uint current, uint next)
{
    // Preorder children and escape links must move forward; reject malformed cycles.
    return next > current ? next : INVALID_INDEX;
}

GPUBVHNodeBounds GetShadowBLASBounds(GPUInstance instance, GPUMeshDescriptor mesh, GPUBVHDescriptor blas, uint nodeIndex)
{
    if (mesh.meshType == MESH_TYPE_SKINNED && instance.blasBoundsOffset != INVALID_INDEX)
        return skinnedBVHBounds[instance.blasBoundsOffset + nodeIndex - blas.ranges.x];
    return bvhBounds[nodeIndex];
}

bool TraceShadowBLAS(uint instanceID, vec3 origin, vec3 direction, float tMin, float tMax)
{
    GPUInstance instance = instances[instanceID];
    if (instance.meshIndex >= uint(meshes.length()) || instance.meshIndex >= uint(bvhDescriptors.length())) return false;
    GPUMeshDescriptor mesh = meshes[instance.meshIndex];
    GPUBVHDescriptor blas = bvhDescriptors[instance.meshIndex];
    vec3 localOrigin = (instance.inverseWorldMatrix * vec4(origin, 1.0)).xyz;
    // Do not normalize: preserve world-space tMin/tMax under nonuniform scale.
    vec3 localDirection = (instance.inverseWorldMatrix * vec4(direction, 0.0)).xyz;
    ShadowRayData localRay = PrepareShadowRay(localOrigin, localDirection);
    uint nodeIndex = blas.metadata.x;
    uint nodeEnd = GetShadowNodeEnd(blas);
    if (nodeIndex < blas.ranges.x) return false;
    while (nodeIndex < nodeEnd)
    {
        GPUBVHNodeTopology node = bvhTopology[nodeIndex];
        GPUBVHNodeBounds bounds = GetShadowBLASBounds(instance, mesh, blas, nodeIndex);
        if (!IntersectShadowAABB(localRay, bounds, tMin, tMax))
        {
            nodeIndex = NextShadowNode(nodeIndex, node.primitiveRange.w);
            continue;
        }
        if (node.treeTopology.w == 0u)
        {
            nodeIndex = NextShadowNode(nodeIndex, node.treeTopology.x);
            continue;
        }
        for (uint i = 0u; i < node.primitiveRange.y; ++i)
        {
            uint triangle = bvhPrimitiveIndices[node.primitiveRange.x + i];
            if (triangle >= mesh.triangleCount) continue;
            uint firstIndex = (mesh.triangleOffset + triangle) * 3u;
            uvec3 triangleIndices = uvec3(indices[firstIndex], indices[firstIndex + 1u], indices[firstIndex + 2u]);
            vec3 v0, v1, v2;
            if (mesh.meshType == MESH_TYPE_SKINNED)
            {
                uint offset = instance.skinnedVertexOffset;
                v0 = outputVertices[offset + triangleIndices.x].position.xyz;
                v1 = outputVertices[offset + triangleIndices.y].position.xyz;
                v2 = outputVertices[offset + triangleIndices.z].position.xyz;
            }
            else
            {
                uint offset = mesh.vertexOffset;
                v0 = vertices[offset + triangleIndices.x].position.xyz;
                v1 = vertices[offset + triangleIndices.y].position.xyz;
                v2 = vertices[offset + triangleIndices.z].position.xyz;
            }
            if (IntersectShadowTriangle(localOrigin, localDirection, v0, v1, v2, tMin, tMax)) return true;
        }
        nodeIndex = NextShadowNode(nodeIndex, node.primitiveRange.w);
    }
    return false;
}

bool TraceAny(vec3 origin, vec3 direction, float tMin, float tMax)
{
    if (tMax <= tMin || uTLASDescriptorIndex >= uint(bvhDescriptors.length())) return false;
    GPUBVHDescriptor tlas = bvhDescriptors[uTLASDescriptorIndex];
    ShadowRayData worldRay = PrepareShadowRay(origin, direction);
    uint nodeIndex = tlas.metadata.x;
    uint nodeEnd = GetShadowNodeEnd(tlas);
    if (nodeIndex < tlas.ranges.x) return false;
    while (nodeIndex < nodeEnd)
    {
        GPUBVHNodeTopology node = bvhTopology[nodeIndex];
        if (!IntersectShadowAABB(worldRay, bvhBounds[nodeIndex], tMin, tMax))
        {
            nodeIndex = NextShadowNode(nodeIndex, node.primitiveRange.w);
            continue;
        }
        if (node.treeTopology.w == 0u)
        {
            nodeIndex = NextShadowNode(nodeIndex, node.treeTopology.x);
            continue;
        }
        for (uint i = 0u; i < node.primitiveRange.y; ++i)
        {
            uint instanceID = bvhPrimitiveIndices[node.primitiveRange.x + i];
            if (instanceID >= uInstanceCount) continue;
            if (TraceShadowBLAS(instanceID, origin, direction, tMin, tMax)) return true;
        }
        nodeIndex = NextShadowNode(nodeIndex, node.primitiveRange.w);
    }
    return false;
}

bool IsLightSampleVisible(vec3 worldPosition, vec3 N, vec3 samplePoint)
{
    vec3 origin = worldPosition + N * SHADOW_BIAS;
    vec3 toLight = samplePoint - origin;
    float distance = length(toLight);
    if (distance <= SHADOW_BIAS) return false;
    return !TraceAny(origin, toLight / distance, SHADOW_T_MIN, distance - SHADOW_BIAS);
}

// BRDF * surface cosine, shared by analytic lights and area samples.
vec3 EvaluateDirectBRDF(GPURTMaterial material, vec3 N, vec3 V, vec3 L)
{
    float NdotL = max(dot(N, L), 0.0);
    float NdotV = max(dot(N, V), 0.0);
    if (NdotL <= 0.0 || NdotV <= 0.0) return vec3(0.0);

    vec3 H = normalize(V + L);
    vec3 albedo = clamp(material.albedoFactor.rgb, vec3(0.0), vec3(1.0));
    float metallic = clamp(material.metallicFactor, 0.0, 1.0);
    float roughness = clamp(material.roughnessFactor, 0.045, 1.0);
    float transmission = clamp(material.transmission, 0.0, 1.0);
    float ior = max(material.ior, 0.001);
    float dielectricF0 = (ior - 1.0) / (ior + 1.0);
    dielectricF0 *= dielectricF0;
    vec3 F0 = mix(vec3(dielectricF0), albedo, metallic);

    float NDF = DistributionGGX(N, H, roughness);
    float G = GeometrySmith(N, V, L, roughness);
    vec3 F = FresnelSchlick(max(dot(H, V), 0.0), F0);
    vec3 specular = (NDF * G * F) / max(4.0 * NdotV * NdotL, EPSILON);
    vec3 kD = (vec3(1.0) - F) * (1.0 - metallic) * (1.0 - transmission);
    return (kD * albedo / PI + specular) * NdotL;
}

vec3 EvaluatePBRLight(LightData light, GPURTMaterial material, vec3 worldPosition, vec3 N, vec3 V)
{
    vec3 L;
    float attenuation = 1.0;
    if (light.type == LIGHT_DIRECTIONAL)
    {
        L = normalize(-light.direction.xyz);
    }
    else if (light.type == LIGHT_POINT || light.type == LIGHT_SPOT)
    {
        vec3 toLight = light.position.xyz - worldPosition;
        float distance = length(toLight);
        if (distance >= light.range || distance <= EPSILON) return vec3(0.0);
        L = toLight / distance;
        attenuation = CalculateAttenuation(light, distance);
        if (light.type == LIGHT_SPOT)
        {
            float theta = dot(-L, normalize(light.direction.xyz));
            float coneWidth = light.innerConeAngle - light.outerConeAngle;
            attenuation *= clamp((theta - light.outerConeAngle) / max(coneWidth, EPSILON), 0.0, 1.0);
        }
    }
    else return vec3(0.0);

    float NdotL = max(dot(N, L), 0.0);
    float NdotV = max(dot(N, V), 0.0);
    if (NdotL <= 0.0 || NdotV <= 0.0) return vec3(0.0);

    if (attenuation <= 0.0) return vec3(0.0);
    // shadowIndex describes shadow maps, not RT visibility. All lights cast RT shadows here.
    if (light.type == LIGHT_DIRECTIONAL)
    {
        if (TraceAny(worldPosition + N * SHADOW_BIAS, L, SHADOW_T_MIN, MAX_RAY_DISTANCE)) return vec3(0.0);
    }
    else if (!IsLightSampleVisible(worldPosition, N, light.position.xyz)) return vec3(0.0);

    vec3 radiance = light.color.rgb * light.intensity * attenuation;
    return EvaluateDirectBRDF(material, N, V, L) * radiance;
}

uint HashSample(uint value)
{
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

float NextSample(inout uint state)
{
    state = HashSample(state + 0x9e3779b9u);
    return float(state >> 8u) * (1.0 / 16777216.0);
}

//[수정] Area and GGX proposals share a solid-angle mixture PDF; all null attempts remain in the average.
float IBLBSDFPdf(GPURTMaterial material, vec3 N, vec3 V, vec3 L);
vec3 IBLSampleBSDF(GPURTMaterial material, vec3 N, vec3 V, inout uint state);

vec3 EvaluateAreaLight(LightData light, GPURTMaterial material, vec3 worldPosition, vec3 N, vec3 V, inout uint state)
{
    if (light.intensity <= 0.0 || light.areaSize.x <= 0.0 || light.areaSize.y <= 0.0) return vec3(0.0);
    vec3 right = light.areaRight.xyz;
    vec3 up = light.areaUp.xyz;
    vec3 normal = cross(right, up);
    float normalLength = length(normal);
    if (normalLength <= EPSILON) return vec3(0.0);
    normal /= normalLength;
    float area = light.areaSize.x * light.areaSize.y;
    if (isnan(area) || isinf(area) || dot(N, V) <= 0.0) return vec3(0.0);
    float ior = max(material.ior, 0.001);
    float f0 = (ior - 1.0) / (ior + 1.0);
    f0 *= f0;
    float metallic = clamp(material.metallicFactor, 0.0, 1.0);
    vec3 baseColor = clamp(material.albedoFactor.rgb, vec3(0.0), vec3(1.0));
    vec3 f0Color = mix(vec3(f0), baseColor, metallic);
    float specularEnergy = max(f0Color.r, max(f0Color.g, f0Color.b));
    float diffuseEnergy = (1.0 - metallic) * (1.0 - clamp(material.transmission, 0.0, 1.0))
        * (1.0 - specularEnergy) * dot(baseColor, vec3(1.0 / 3.0));
    float bsdfProbability = 0.0;
    if (specularEnergy + diffuseEnergy > 0.0)
        bsdfProbability = min(0.95, specularEnergy / (specularEnergy + diffuseEnergy));
    // Broad lobes favor the original area proposal; avoid adding null-sample variance there.
    bsdfProbability *= 1.0 - smoothstep(0.2, 0.5, material.roughnessFactor);
    uint sampleCount = clamp(uAreaSampleCount, 1u, 8u);
    vec3 radiance = vec3(0.0);
    for (uint i = 0u; i < sampleCount; ++i)
    {
        vec3 samplePoint;
        if (bsdfProbability > 0.0 && NextSample(state) < bsdfProbability)
        {
            vec3 direction = IBLSampleBSDF(material, N, V, state);
            float denominator = dot(direction, normal);
            if (abs(denominator) < 1e-8) continue;
            float t = dot(light.position.xyz - worldPosition, normal) / denominator;
            if (t <= SHADOW_BIAS) continue;
            samplePoint = worldPosition + t * direction;
            vec3 offset = samplePoint - light.position.xyz;
            vec2 coordinates = vec2(dot(offset, right) / dot(right, right), dot(offset, up) / dot(up, up));
            if (any(greaterThan(abs(coordinates), 0.5 * light.areaSize.xy))) continue;
        }
        else
        {
            vec2 xi = vec2(NextSample(state), NextSample(state));
            samplePoint = light.position.xyz + right * ((xi.x - 0.5) * light.areaSize.x)
                + up * ((xi.y - 0.5) * light.areaSize.y);
        }
        vec3 toLight = samplePoint - worldPosition;
        float distanceSquared = dot(toLight, toLight);
        if (distanceSquared <= SHADOW_BIAS * SHADOW_BIAS || isnan(distanceSquared) || isinf(distanceSquared)) continue;
        vec3 L = toLight * inversesqrt(distanceSquared);
        float emitterCos = dot(normal, -L);
        if ((light.lightFlags & 1u) != 0u) emitterCos = abs(emitterCos);
        if (emitterCos <= 0.0 || dot(N, L) <= 0.0) continue;
        float areaPdf = distanceSquared / (emitterCos * area);
        float bsdfPdf = IBLBSDFPdf(material, N, V, L);
        float pdf = (1.0 - bsdfProbability) * areaPdf + bsdfProbability * bsdfPdf;
        if (!(pdf > 0.0)) continue;
        vec3 contribution = EvaluateDirectBRDF(material, N, V, L) * light.color.rgb * light.intensity / pdf;
        if (all(lessThanEqual(contribution, vec3(0.0)))) continue;
        if (IsLightSampleVisible(worldPosition, N, samplePoint)) radiance += contribution;
    }
    return radiance / float(sampleCount);
}

