layout(binding=16) uniform sampler2D rtEnvironmentImage;
layout(binding=17) uniform sampler2D rtEnvironmentDistribution;
layout(std140,binding=3) uniform RTEnvironmentData
{
    vec4 environmentTransform; // cos(yaw), sin(yaw), intensity, ready
    uvec4 environmentDistributionSize;
};
const float IBL_PI=3.14159265358979323846;
bool IBLEnvironmentReady(){return uEnvironmentEnabled!=0u&&environmentTransform.w>0.0;}
vec3 IBLToEnvironment(vec3 d){float c=environmentTransform.x,s=environmentTransform.y;return vec3(c*d.x-s*d.z,d.y,s*d.x+c*d.z);}
vec3 IBLToWorld(vec3 d){float c=environmentTransform.x,s=environmentTransform.y;return vec3(c*d.x+s*d.z,d.y,-s*d.x+c*d.z);}
vec2 IBLEnvironmentUV(vec3 direction)
{
    vec3 d=normalize(IBLToEnvironment(direction));
    float longitude=dot(d.xz,d.xz)>1e-12?atan(d.z,d.x):0.0;
    return vec2(longitude/(2.0*IBL_PI)+0.5,asin(clamp(d.y,-1.0,1.0))/IBL_PI+0.5);
}
vec3 IBLEnvironmentRadiance(vec3 direction)
{
    vec3 value=textureLod(rtEnvironmentImage,IBLEnvironmentUV(direction),0.0).rgb;
    if(any(isnan(value))||any(isinf(value)))return vec3(0.0);
    vec3 radiance=max(value,vec3(0.0))*environmentTransform.z;
    if(any(isnan(radiance))||any(isinf(radiance)))return vec3(0.0);
    return radiance;
}
uint IBLHash(uint x){x^=x>>16u;x*=0x7feb352du;x^=x>>15u;x*=0x846ca68bu;return x^(x>>16u);}
float IBLRandom(inout uint state){state=IBLHash(state+0x9e3779b9u);return float(state>>8u)*(1.0/16777216.0);}
vec3 IBLBasis(vec3 N,vec3 local)
{
    vec3 axis=abs(N.z)<0.999?vec3(0,0,1):vec3(0,1,0);
    vec3 T=normalize(cross(axis,N));return normalize(T*local.x+cross(N,T)*local.y+N*local.z);
}
vec3 IBLCosineDirection(vec3 N,inout uint state)
{
    float u=IBLRandom(state),phi=2.0*IBL_PI*IBLRandom(state),r=sqrt(u);
    return IBLBasis(N,vec3(r*cos(phi),r*sin(phi),sqrt(max(0.0,1.0-u))));
}
float IBLTexelSolidAngle(int y,ivec2 size)
{
    float lo=IBL_PI*(float(y)/float(size.y)-0.5),hi=IBL_PI*(float(y+1)/float(size.y)-0.5);
    return (2.0*IBL_PI/float(size.x))*(sin(hi)-sin(lo));
}
float IBLEnvironmentPdf(vec3 direction)
{
    ivec2 size=ivec2(environmentDistributionSize.xy);
    float total=texelFetch(rtEnvironmentDistribution,ivec2(size.y-1,size.y),0).r;
    if(!(total>0.0)||isinf(total)||isnan(total))return 1.0/(4.0*IBL_PI);
    ivec2 pixel=clamp(ivec2(IBLEnvironmentUV(direction)*vec2(size)),ivec2(0),size-1);
    float mass=texelFetch(rtEnvironmentDistribution,pixel,0).g;
    return 0.99*mass/IBLTexelSolidAngle(pixel.y,size)+0.01/(4.0*IBL_PI);
}
vec3 IBLSampleEnvironment(inout uint state)
{
    ivec2 size=ivec2(environmentDistributionSize.xy);
    float total=texelFetch(rtEnvironmentDistribution,ivec2(size.y-1,size.y),0).r;
    float choice=IBLRandom(state);
    if(!(total>0.0)||isinf(total)||isnan(total)||choice<0.01)
    {
        float y=2.0*IBLRandom(state)-1.0,phi=2.0*IBL_PI*IBLRandom(state);
        float r=sqrt(max(0.0,1.0-y*y));return IBLToWorld(vec3(r*cos(phi),y,r*sin(phi)));
    }
    float target=IBLRandom(state)*total;
    int lo=0,hi=size.y-1;
    while(lo<hi){int mid=(lo+hi)/2;if(texelFetch(rtEnvironmentDistribution,ivec2(mid,size.y),0).r<=target)lo=mid+1;else hi=mid;}
    int y=lo;float rowTotal=texelFetch(rtEnvironmentDistribution,ivec2(size.x-1,y),0).r;
    target=IBLRandom(state)*rowTotal;lo=0;hi=size.x-1;
    while(lo<hi){int mid=(lo+hi)/2;if(texelFetch(rtEnvironmentDistribution,ivec2(mid,y),0).r<=target)lo=mid+1;else hi=mid;}
    float u=(float(lo)+IBLRandom(state))/float(size.x);
    float latLo=IBL_PI*(float(y)/float(size.y)-0.5),latHi=IBL_PI*(float(y+1)/float(size.y)-0.5);
    float sy=mix(sin(latLo),sin(latHi),IBLRandom(state));float rr=sqrt(max(0.0,1.0-sy*sy));
    float phi=(u-0.5)*2.0*IBL_PI;return IBLToWorld(vec3(rr*cos(phi),sy,rr*sin(phi)));
}

// Environment shares the existing GGX/Schlick-GGX reflection model.
bool IBLHasRoughContinuation(GPURTMaterial m){return m.roughnessFactor>=0.045&&m.transmission<=0.0;}
vec3 IBLF0(GPURTMaterial m)
{
    float ior=max(m.ior,0.001),f=(ior-1.0)/(ior+1.0);
    return mix(vec3(f*f),clamp(m.albedoFactor.rgb,vec3(0),vec3(1)),clamp(m.metallicFactor,0.0,1.0));
}
vec3 IBLFresnel(float cosine,vec3 f0){return f0+(1.0-f0)*pow(1.0-clamp(cosine,0.0,1.0),5.0);}
float IBLDistribution(vec3 N,vec3 H,float roughness)
{
    float a=clamp(roughness,0.045,1.0);a*=a;float a2=a*a;
    float nh=clamp(dot(N,H),0.0,1.0),den=dot(cross(N,H),cross(N,H))+a2*nh*nh;
    return a2/(IBL_PI*den*den);
}
float IBLGeometry(float cosine,float roughness)
{
    float rr=clamp(roughness,0.045,1.0)+1.0,k=rr*rr/8.0;
    return cosine/max(cosine*(1.0-k)+k,0.0001);
}
void IBLComponents(GPURTMaterial m,vec3 N,vec3 V,vec3 L,out vec3 diffuse,out vec3 specular)
{
    diffuse=vec3(0);specular=vec3(0);
    float nl=max(dot(N,L),0.0),nv=max(dot(N,V),0.0);
    if(nl<=0.0||nv<=0.0||dot(V+L,V+L)<1e-12)return;
    vec3 H=normalize(V+L),F=IBLFresnel(max(dot(H,V),0.0),IBLF0(m));
    if(m.ior==1.0&&m.metallicFactor<=0.0)F=vec3(0);
    diffuse=(1.0-F)*(1.0-clamp(m.metallicFactor,0.0,1.0))*(1.0-clamp(m.transmission,0.0,1.0))*clamp(m.albedoFactor.rgb,vec3(0),vec3(1))*(nl/IBL_PI);
    if(IBLHasRoughContinuation(m))specular=IBLDistribution(N,H,m.roughnessFactor)*IBLGeometry(nv,m.roughnessFactor)*IBLGeometry(nl,m.roughnessFactor)*F/max(4.0*nv*nl,0.0001)*nl;
}
vec3 IBLBRDFCos(GPURTMaterial m,vec3 N,vec3 V,vec3 L)
{
    vec3 diffuse,specular;IBLComponents(m,N,V,L,diffuse,specular);return diffuse+specular;
}
float IBLSpecularProbability(GPURTMaterial m){return 0.5+0.5*clamp(m.metallicFactor,0.0,1.0);}
float IBLBSDFPdf(GPURTMaterial m,vec3 N,vec3 V,vec3 L)
{
    float nl=max(dot(N,L),0.0);if(nl<=0.0||dot(V+L,V+L)<1e-12)return 0.0;
    vec3 H=normalize(V+L);float vh=dot(V,H);if(vh<=0.0)return 0.0;
    float specular=IBLDistribution(N,H,m.roughnessFactor)*max(dot(N,H),0.0)/(4.0*vh);
    return specular;
}
vec3 IBLSampleBSDF(GPURTMaterial m,vec3 N,vec3 V,inout uint state)
{
    float u=IBLRandom(state),phi=2.0*IBL_PI*IBLRandom(state);
    float a=clamp(m.roughnessFactor,0.045,1.0);a*=a;float a2=a*a;
    float ct=sqrt((1.0-u)/(1.0+(a2-1.0)*u)),st=sqrt(max(0.0,1.0-ct*ct));
    vec3 H=IBLBasis(N,vec3(st*cos(phi),st*sin(phi),ct));return reflect(-V,H);
}
float IBLProposalPdf(vec3 N,vec3 L){return uIBLSamplingMode==0u?max(dot(N,L),0.0)/IBL_PI:IBLEnvironmentPdf(L);}

vec3 EvaluateEnvironmentLight(GPURayWorkItem ray,GPURTMaterial material,vec3 position,vec3 N,vec3 V)
{
    if(!IBLEnvironmentReady()||uIBLEnabled==0u||uIBLSampleCount==0u||environmentTransform.z<=0.0)return vec3(0);
    if(!IBLHasRoughContinuation(material)&&(material.metallicFactor>=1.0||material.transmission>=1.0))return vec3(0);
    uint state=IBLHash(ray.payload.pixelIndex^IBLHash(ray.payload.depth+719u)^IBLHash(uFrameIndex+113u)^IBLHash(floatBitsToUint(ray.ray.direction.x))^IBLHash(floatBitsToUint(ray.ray.direction.y)));
    vec3 result=vec3(0);uint count=clamp(uIBLSampleCount,1u,8u);
    bool continuation=uIBLSamplingMode==2u&&ray.payload.depth<uMaxBounces&&IBLHasRoughContinuation(material);
    for(uint i=0u;i<count;++i)
    {
        vec3 L=uIBLSamplingMode==0u?IBLCosineDirection(N,state):IBLSampleEnvironment(state);
        if(dot(N,L)<=0.0)continue;
        float pe=IBLProposalPdf(N,L);if(!(pe>0.0))continue;
        vec3 diffuse,specular;IBLComponents(material,N,V,L,diffuse,specular);if(all(lessThanEqual(diffuse+specular,vec3(0))))continue;
        vec3 Le=IBLEnvironmentRadiance(L);if(all(lessThanEqual(Le,vec3(0))))continue;
        float pb=continuation?IBLBSDFPdf(material,N,V,L):0.0;
        float weight=(float(count)*pe)/(float(count)*pe+pb);
        if(!TraceAny(position+N*SHADOW_BIAS,L,SHADOW_T_MIN,MAX_RAY_DISTANCE))result+=(diffuse+specular*weight)*Le/pe;
    }
    return result/float(count);
}
void main()
{
    uint rayIndex = gl_GlobalInvocationID.x;
    if (rayIndex >= rayCount) return;

    // Clear every queued slot, including inactive rays and misses.
    directLighting[rayIndex] = vec4(0.0);
    GPURayWorkItem ray = rays[rayIndex];
    if ((ray.payload.flags & RAY_ACTIVE) == 0u) return;
    GPUSurfaceData surface = surfaces[rayIndex];
    if (surface.valid == 0u) return;

    GPURTMaterial material = materials[surface.materialIndex];
    material.albedoFactor = surface.albedo;
    material.emission = surface.emission;
    material.metallicFactor = surface.materialParams.x;
    material.roughnessFactor = surface.materialParams.y;
    material.transmission = surface.materialParams.w;

    vec3 worldNormal = normalize(surface.worldNormal.xyz);
    vec3 V = normalize(-ray.ray.direction.xyz);
    vec3 N = dot(worldNormal, V) < 0.0 ? -worldNormal : worldNormal;
    vec3 radiance = vec3(0.0);
    for (uint i = 0u; i < uint(lights.length()); ++i)
    {
        LightData light = lights[i];
        if (light.type == LIGHT_RECT_AREA)
        {
            uint state = HashSample(rayIndex ^ HashSample(i + 1u) ^ HashSample(ray.payload.depth + 17u) ^ HashSample(uFrameIndex + 31u));
            radiance += EvaluateAreaLight(light, material, surface.worldPosition.xyz, N, V, state);
        }
        else
        {
            radiance += EvaluatePBRLight(light, material, surface.worldPosition.xyz, N, V);
        }
    }
    radiance += EvaluateEnvironmentLight(ray, material, surface.worldPosition.xyz, N, V);
    directLighting[rayIndex] = vec4(radiance, 0.0);
}
