#version 460 core
layout(local_size_x=64) in;
layout(binding=16) uniform sampler2D environmentImage;
layout(rg32f,binding=0) uniform image2D distributionImage;
void main()
{
    ivec2 size=imageSize(distributionImage); int height=size.y-1;
    int y=int(gl_GlobalInvocationID.x); if(y>=height)return;
    const float PI=3.141592653589793;
    float lo=PI*(float(y)/float(height)-0.5), hi=PI*(float(y+1)/float(height)-0.5);
    float solidAngle=(2.0*PI/float(size.x))*(sin(hi)-sin(lo));
    float sum=0.0;
    for(int x=0;x<size.x;++x)
    {
        vec3 value=textureLod(environmentImage,(vec2(x,y)+0.5)/vec2(size.x,height),0.0).rgb;
        if(any(isnan(value))||any(isinf(value)))value=vec3(0.0);
        float mass=max(dot(max(value,vec3(0.0)),vec3(0.2126,0.7152,0.0722)),0.0)*solidAngle;
        sum+=mass; imageStore(distributionImage,ivec2(x,y),vec4(sum,mass,0,0));
    }
}
