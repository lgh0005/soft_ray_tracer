// RTBVH shading: consumes precomputed surface data from binding 21.

#version 460 core

// C++ GPU data layout

// Prepared once per ray by RTBVHSurfacePreparePass.
struct GPUSurfaceData
{
    vec4 worldPosition;
    vec4 worldNormal;
    vec4 albedo;
    vec4 emission;
    vec4 materialParams; // x=metallic, y=roughness, z=material AO, w=transmission
    uint materialIndex;
    uint instanceIndex;
    uint valid;
    uint pad0;
};

layout(local_size_x = 64) in;

// ==================================================
// Constants
// ==================================================

const uint RAY_ACTIVE = 1u;

// 0: Primary Normal Debug
// 1: PBR Direct Lighting
// 2: Material Index Debug
const uint SHADING_MODE = 1u;

// Fixed-Point Accumulation
const float ACCUM_SCALE = 4096.0;
const float MAX_CONTRIBUTION = 1024.0;

// ==================================================
// Ray Structures
// ==================================================

struct GPURay
{
    vec4 origin;
    vec4 direction;
};

struct GPURayPayload
{
    vec4 throughput;

    uint pixelIndex;
    uint depth;
    uint flags;
    uint pad0;
};

struct GPURayWorkItem
{
    GPURay ray;
    GPURayPayload payload;
};

// ==================================================
// Hit Structure
// ==================================================

struct GPUHit
{
    // x: t
    // y: barycentric u
    // z: barycentric v
    vec4 intersection;

    // x: instanceID
    // y: globalTriangleID
    // z: hasHit
    uvec4 identifiers;
};

// ==================================================
// Geometry Structures
// ==================================================


// ==================================================
// Accumulation Structure
// ==================================================

struct GPUAccumPixel
{
    uint r;
    uint g;
    uint b;
    uint pad0;
};

// ==================================================
// SSBO
// ==================================================

// Binding 0: Current Ray Queue
layout(std430, binding = 0) readonly buffer RayBuffer
{
    GPURayWorkItem rays[];
};

// Binding 1: Hit Buffer
layout(std430, binding = 1) readonly buffer HitBuffer
{
    GPUHit hits[];
};

// Binding 21: Prepared surface data, one entry per current ray.
layout(std430, binding = 21) readonly buffer SurfaceBuffer
{
    GPUSurfaceData surfaces[];
};

// Binding 22: direct lighting computed once for this ray.
layout(std430, binding = 22) readonly buffer DirectLightingBuffer
{
    vec4 directLighting[];
};

// Binding 11: Current Ray Counter
layout(std430, binding = 11) readonly buffer RayCounterBuffer
{
    uint rayCount;
};

// Binding 14: Accumulation Buffer
layout(std430, binding = 14) buffer AccumulationBuffer
{
    GPUAccumPixel accumulation[];
};

// ==================================================
// Frame UBO
// ==================================================

layout(std140, binding = 1) uniform RTFrameData
{
    uint uPrimaryRayCount;
    uint uInstanceCount;
    uint _pad0;
    uint _pad1;
};

// ==================================================
// Atomic Accumulation
// ==================================================

void AccumulateRadiance(
    uint pixelIndex,
    vec3 radiance)
{
    if (pixelIndex >= uPrimaryRayCount)
        return;

    // Nonnegative radiance only
    vec3 value = clamp(
        radiance,
        vec3(0.0),
        vec3(MAX_CONTRIBUTION)
    );

    // Float -> Fixed-Point
    uvec3 encoded = uvec3(
        round(value * ACCUM_SCALE)
    );

    // Atomic accumulation
    atomicAdd(
        accumulation[pixelIndex].r,
        encoded.r
    );

    atomicAdd(
        accumulation[pixelIndex].g,
        encoded.g
    );

    atomicAdd(
        accumulation[pixelIndex].b,
        encoded.b
    );
}

// ==================================================
// Environment
// ==================================================

vec3 SampleEnvironment(vec3 rayDirection)
{
    vec3 direction = normalize(rayDirection);

    float t = clamp(
        direction.y * 0.5 + 0.5,
        0.0,
        1.0
    );

    vec3 horizon = vec3(0.55, 0.68, 0.80);
    vec3 zenith  = vec3(0.08, 0.18, 0.40);

    return mix(horizon, zenith, t);
}

// ==================================================
// PBR Direct Lighting
// ==================================================

// Scene lights use Rendering::LightData (std430 stride 96), separate from RT geometry bindings.
//[수정] C++ LightData와 배치를 맞춘 씬 조명 SSBO
// ==================================================
// Material Index Debug
// ==================================================

vec3 DebugMaterialIndex(uint materialID)
{
    // Color by table index, without assigning a material model to that index.
    uint hash = materialID * 1664525u + 1013904223u;
    return vec3(hash & 255u, (hash >> 8u) & 255u, (hash >> 16u) & 255u) / 255.0;
}

// ==================================================
// Main
// ==================================================

void main()
{
    // 1. Current Ray Queue Index
    uint rayIndex = gl_GlobalInvocationID.x;

    if (rayIndex >= rayCount)
        return;

    // 2. Current Ray
    GPURayWorkItem ray = rays[rayIndex];

    if ((ray.payload.flags & RAY_ACTIVE) == 0u)
        return;

    // 3. Original Pixel
    uint pixelIndex = ray.payload.pixelIndex;

    if (pixelIndex >= uPrimaryRayCount)
        return;

    // 4. Debug Modes: Primary Ray Only
    if (SHADING_MODE != 1u &&
        ray.payload.depth != 0u)
    {
        return;
    }

    // 5. Hit Result
    GPUHit hit = hits[rayIndex];

    vec3 radiance = vec3(0.0);

    // ==================================================
    // Miss
    // ==================================================

    if (hit.identifiers.z == 0u)
    {
        if (SHADING_MODE == 1u)
        {
            radiance = SampleEnvironment(
                ray.ray.direction.xyz
            );
        }
    }
    // ==================================================
    // Surface Hit
    // ==================================================
    else
    {
        GPUSurfaceData surface = surfaces[rayIndex];

        // In the surface-prepare pass, miss/inactive entries are invalidated.
        if (surface.valid != 0u)
        {
            uint materialID = surface.materialIndex;

            if (SHADING_MODE == 2u)
            {
                radiance = DebugMaterialIndex(materialID);
            }
            else
            {
                vec3 worldNormal = normalize(surface.worldNormal.xyz);

                if (SHADING_MODE == 0u)
                {
                    radiance = worldNormal * 0.5 + 0.5;
                }
                else
                {
                    radiance = max(surface.emission.rgb, vec3(0.0));
                    // RTBVHLightingPass already evaluated direct BRDF light.
                    // Leave emission & environment miss in Shading Pass.
                    radiance += directLighting[rayIndex].rgb;
                }
            }
        }
    }

    // ==================================================
    // Apply Throughput
    // ==================================================

    vec3 contribution =
        ray.payload.throughput.rgb * radiance;

    // ==================================================
    // Accumulate Radiance
    // ==================================================

    AccumulateRadiance(
        pixelIndex,
        contribution
    );
}
