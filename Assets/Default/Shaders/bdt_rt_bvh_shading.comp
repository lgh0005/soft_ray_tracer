// RTBVH shading: consumes precomputed surface data from binding 21.

#version 460 core

layout(std140, binding = 2) uniform RTRenderSettings
{
    uint uMaxBounces;
    uint uAreaSampleCount;
    uint uTraceResolutionDivisor;
    uint uDenoiseEnabled;
    uint uTemporal;
    uint uSpatialIterations;
    uint uMaxAOSampleCount;
    uint uAOEnabled;
    uint uVisualizeAO;
    uint uAOSampleCount;
    float uAORadius;
    uint _settingsPad0;
    uint uEnvironmentEnabled;
    uint uIBLEnabled;
    uint uIBLSampleCount;
    uint uIBLSamplingMode;
    float uIBLIntensity;
    float uEnvironmentRotation;
    uint _iblPad0;
    uint _iblPad1;
};

layout(binding=16) uniform sampler2D rtEnvironmentImage;
layout(binding=17) uniform sampler2D rtEnvironmentDistribution;
layout(std140,binding=3) uniform RTEnvironmentData
{
    vec4 environmentTransform; // cos(yaw), sin(yaw), intensity, ready
    uvec4 environmentDistributionSize;
};
const float IBL_PI=3.14159265358979323846;
bool IBLEnvironmentReady(){return uEnvironmentEnabled!=0u&&environmentTransform.w>0.0;}
vec3 IBLToEnvironment(vec3 d){float c=environmentTransform.x,s=environmentTransform.y;return vec3(c*d.x-s*d.z,d.y,s*d.x+c*d.z);}
vec3 IBLToWorld(vec3 d){float c=environmentTransform.x,s=environmentTransform.y;return vec3(c*d.x+s*d.z,d.y,-s*d.x+c*d.z);}
vec2 IBLEnvironmentUV(vec3 direction)
{
    vec3 d=normalize(IBLToEnvironment(direction));
    float longitude=dot(d.xz,d.xz)>1e-12?atan(d.z,d.x):0.0;
    return vec2(longitude/(2.0*IBL_PI)+0.5,asin(clamp(d.y,-1.0,1.0))/IBL_PI+0.5);
}
vec3 IBLEnvironmentRadiance(vec3 direction)
{
    vec3 value=textureLod(rtEnvironmentImage,IBLEnvironmentUV(direction),0.0).rgb;
    if(any(isnan(value))||any(isinf(value)))return vec3(0.0);
    vec3 radiance=max(value,vec3(0.0))*environmentTransform.z;
    if(any(isnan(radiance))||any(isinf(radiance)))return vec3(0.0);
    return radiance;
}
uint IBLHash(uint x){x^=x>>16u;x*=0x7feb352du;x^=x>>15u;x*=0x846ca68bu;return x^(x>>16u);}
float IBLRandom(inout uint state){state=IBLHash(state+0x9e3779b9u);return float(state>>8u)*(1.0/16777216.0);}
vec3 IBLBasis(vec3 N,vec3 local)
{
    vec3 axis=abs(N.z)<0.999?vec3(0,0,1):vec3(0,1,0);
    vec3 T=normalize(cross(axis,N));return normalize(T*local.x+cross(N,T)*local.y+N*local.z);
}
vec3 IBLCosineDirection(vec3 N,inout uint state)
{
    float u=IBLRandom(state),phi=2.0*IBL_PI*IBLRandom(state),r=sqrt(u);
    return IBLBasis(N,vec3(r*cos(phi),r*sin(phi),sqrt(max(0.0,1.0-u))));
}
float IBLTexelSolidAngle(int y,ivec2 size)
{
    float lo=IBL_PI*(float(y)/float(size.y)-0.5),hi=IBL_PI*(float(y+1)/float(size.y)-0.5);
    return (2.0*IBL_PI/float(size.x))*(sin(hi)-sin(lo));
}
float IBLEnvironmentPdf(vec3 direction)
{
    ivec2 size=ivec2(environmentDistributionSize.xy);
    float total=texelFetch(rtEnvironmentDistribution,ivec2(size.y-1,size.y),0).r;
    if(!(total>0.0)||isinf(total)||isnan(total))return 1.0/(4.0*IBL_PI);
    ivec2 pixel=clamp(ivec2(IBLEnvironmentUV(direction)*vec2(size)),ivec2(0),size-1);
    float mass=texelFetch(rtEnvironmentDistribution,pixel,0).g;
    return 0.99*mass/IBLTexelSolidAngle(pixel.y,size)+0.01/(4.0*IBL_PI);
}
vec3 IBLSampleEnvironment(inout uint state)
{
    ivec2 size=ivec2(environmentDistributionSize.xy);
    float total=texelFetch(rtEnvironmentDistribution,ivec2(size.y-1,size.y),0).r;
    float choice=IBLRandom(state);
    if(!(total>0.0)||isinf(total)||isnan(total)||choice<0.01)
    {
        float y=2.0*IBLRandom(state)-1.0,phi=2.0*IBL_PI*IBLRandom(state);
        float r=sqrt(max(0.0,1.0-y*y));return IBLToWorld(vec3(r*cos(phi),y,r*sin(phi)));
    }
    float target=IBLRandom(state)*total;
    int lo=0,hi=size.y-1;
    while(lo<hi){int mid=(lo+hi)/2;if(texelFetch(rtEnvironmentDistribution,ivec2(mid,size.y),0).r<=target)lo=mid+1;else hi=mid;}
    int y=lo;float rowTotal=texelFetch(rtEnvironmentDistribution,ivec2(size.x-1,y),0).r;
    target=IBLRandom(state)*rowTotal;lo=0;hi=size.x-1;
    while(lo<hi){int mid=(lo+hi)/2;if(texelFetch(rtEnvironmentDistribution,ivec2(mid,y),0).r<=target)lo=mid+1;else hi=mid;}
    float u=(float(lo)+IBLRandom(state))/float(size.x);
    float latLo=IBL_PI*(float(y)/float(size.y)-0.5),latHi=IBL_PI*(float(y+1)/float(size.y)-0.5);
    float sy=mix(sin(latLo),sin(latHi),IBLRandom(state));float rr=sqrt(max(0.0,1.0-sy*sy));
    float phi=(u-0.5)*2.0*IBL_PI;return IBLToWorld(vec3(rr*cos(phi),sy,rr*sin(phi)));
}

// C++ GPU data layout

// Prepared once per ray by RTBVHSurfacePreparePass.
struct GPUSurfaceData
{
    vec4 worldPosition;
    vec4 worldNormal;
    vec4 albedo;
    vec4 emission;
    vec4 materialParams; // x=metallic, y=roughness, z=material AO, w=transmission
    uint materialIndex;
    uint instanceIndex;
    uint valid;
    uint pad0;
};

layout(local_size_x = 64) in;

// ==================================================
// Constants
// ==================================================

const uint RAY_ACTIVE = 1u;
const uint RAY_ENVIRONMENT_MIS_WEIGHT = 2u;

// 0: Primary Normal Debug
// 1: PBR Direct Lighting
// 2: Material Index Debug
const uint SHADING_MODE = 1u;

// Fixed-Point Accumulation
const float ACCUM_SCALE = 4096.0;
const float MAX_CONTRIBUTION = 1024.0;

// ==================================================
// Ray Structures
// ==================================================

struct GPURay
{
    vec4 origin;
    vec4 direction;
};

struct GPURayPayload
{
    vec4 throughput;

    uint pixelIndex;
    uint depth;
    uint flags;
    uint pad0;
};

struct GPURayWorkItem
{
    GPURay ray;
    GPURayPayload payload;
};

// ==================================================
// Hit Structure
// ==================================================

struct GPUHit
{
    // x: t
    // y: barycentric u
    // z: barycentric v
    vec4 intersection;

    // x: instanceID
    // y: globalTriangleID
    // z: hasHit
    uvec4 identifiers;
};

// ==================================================
// Geometry Structures
// ==================================================


// ==================================================
// Accumulation Structure
// ==================================================

struct GPUAccumPixel
{
    uint r;
    uint g;
    uint b;
    uint pad0;
};

// ==================================================
// SSBO
// ==================================================

// Binding 0: Current Ray Queue
layout(std430, binding = 0) readonly buffer RayBuffer
{
    GPURayWorkItem rays[];
};

// Binding 1: Hit Buffer
layout(std430, binding = 1) readonly buffer HitBuffer
{
    GPUHit hits[];
};

// Binding 21: Prepared surface data, one entry per current ray.
layout(std430, binding = 21) readonly buffer SurfaceBuffer
{
    GPUSurfaceData surfaces[];
};

// Binding 22: direct lighting computed once for this ray.
layout(std430, binding = 22) readonly buffer DirectLightingBuffer
{
    vec4 directLighting[];
};

layout(std430, binding = 23) readonly buffer AmbientOcclusionBuffer
{
    float ambientOcclusion[];
};

// Binding 11: Current Ray Counter
layout(std430, binding = 11) readonly buffer RayCounterBuffer
{
    uint rayCount;
};

// Binding 14: Accumulation Buffer
layout(std430, binding = 14) buffer AccumulationBuffer
{
    GPUAccumPixel accumulation[];
};

// ==================================================
// Frame UBO
// ==================================================

layout(std140, binding = 1) uniform RTFrameData
{
    uint uPrimaryRayCount;
    uint uInstanceCount;
    uint uTLASDescriptorIndex;
    uint _pad1;
};

// ==================================================
// Atomic Accumulation
// ==================================================

void AccumulateRadiance(
    uint pixelIndex,
    vec3 radiance)
{
    if (pixelIndex >= uPrimaryRayCount)
        return;

    //[수정] Store float bits in the shared 16-byte pixel; portable CAS avoids fixed-point clipping.
    if (any(isnan(radiance)) || any(isinf(radiance))) return;
    vec3 value = max(radiance, vec3(0.0));
    uint oldr = atomicAdd(accumulation[pixelIndex].r, 0u);
    for (;;)
    {
        uint expected = oldr;
        float sum = uintBitsToFloat(expected) + value.r;
        if (isinf(sum)) sum = 3.402823466e+38;
        oldr = atomicCompSwap(accumulation[pixelIndex].r, expected, floatBitsToUint(sum));
        if (oldr == expected) break;
    }
    uint oldg = atomicAdd(accumulation[pixelIndex].g, 0u);
    for (;;)
    {
        uint expected = oldg;
        float sum = uintBitsToFloat(expected) + value.g;
        if (isinf(sum)) sum = 3.402823466e+38;
        oldg = atomicCompSwap(accumulation[pixelIndex].g, expected, floatBitsToUint(sum));
        if (oldg == expected) break;
    }
    uint oldb = atomicAdd(accumulation[pixelIndex].b, 0u);
    for (;;)
    {
        uint expected = oldb;
        float sum = uintBitsToFloat(expected) + value.b;
        if (isinf(sum)) sum = 3.402823466e+38;
        oldb = atomicCompSwap(accumulation[pixelIndex].b, expected, floatBitsToUint(sum));
        if (oldb == expected) break;
    }

}

// ==================================================
// Environment
// ==================================================


vec3 SampleEnvironment(vec3 rayDirection)
{
    if (IBLEnvironmentReady()) return IBLEnvironmentRadiance(rayDirection);
    vec3 direction = normalize(rayDirection);

    float t = clamp(
        direction.y * 0.5 + 0.5,
        0.0,
        1.0
    );

    vec3 horizon = vec3(0.55, 0.68, 0.80);
    vec3 zenith  = vec3(0.08, 0.18, 0.40);

    return mix(horizon, zenith, t);
}

// ==================================================
// Material Index Debug
// ==================================================

vec3 DebugMaterialIndex(uint materialID)
{
    // Color by table index, without assigning a material model to that index.
    uint hash = materialID * 1664525u + 1013904223u;
    return vec3(hash & 255u, (hash >> 8u) & 255u, (hash >> 16u) & 255u) / 255.0;
}

// ==================================================
// Main
// ==================================================

void main()
{
    // 1. Current Ray Queue Index
    uint rayIndex = gl_GlobalInvocationID.x;

    if (rayIndex >= rayCount)
        return;

    // 2. Current Ray
    GPURayWorkItem ray = rays[rayIndex];

    if ((ray.payload.flags & RAY_ACTIVE) == 0u)
        return;

    // 3. Original Pixel
    uint pixelIndex = ray.payload.pixelIndex;

    if (pixelIndex >= uPrimaryRayCount)
        return;

    if (uVisualizeAO != 0u)
    {
        if (ray.payload.depth == 0u)
            AccumulateRadiance(pixelIndex, vec3(clamp(ambientOcclusion[rayIndex], 0.0, 1.0)));
        return;
    }

    // 4. Debug Modes: Primary Ray Only
    if (SHADING_MODE != 1u &&
        ray.payload.depth != 0u)
    {
        return;
    }

    // 5. Hit Result
    GPUHit hit = hits[rayIndex];

    vec3 radiance = vec3(0.0);

    // ==================================================
    // Miss
    // ==================================================

    if (hit.identifiers.z == 0u)
    {
        if (SHADING_MODE == 1u)
        {
            radiance = SampleEnvironment(ray.ray.direction.xyz);
            if ((ray.payload.flags & RAY_ENVIRONMENT_MIS_WEIGHT) != 0u) radiance *= uintBitsToFloat(ray.payload.pad0);
        }
    }
    // ==================================================
    // Surface Hit
    // ==================================================
    else
    {
        GPUSurfaceData surface = surfaces[rayIndex];

        // In the surface-prepare pass, miss/inactive entries are invalidated.
        if (surface.valid != 0u)
        {
            uint materialID = surface.materialIndex;

            if (SHADING_MODE == 2u)
            {
                radiance = DebugMaterialIndex(materialID);
            }
            else
            {
                vec3 worldNormal = normalize(surface.worldNormal.xyz);

                if (SHADING_MODE == 0u)
                {
                    radiance = worldNormal * 0.5 + 0.5;
                }
                else
                {
                    radiance = max(surface.emission.rgb, vec3(0.0));
                    // RTBVHLightingPass already evaluated direct BRDF light.
                    // Leave emission & environment miss in Shading Pass.
                    radiance += directLighting[rayIndex].rgb;
                }
            }
        }
    }

    // ==================================================
    // Apply Throughput
    // ==================================================

    vec3 contribution =
        ray.payload.throughput.rgb * radiance;

    // ==================================================
    // Accumulate Radiance
    // ==================================================

    AccumulateRadiance(
        pixelIndex,
        contribution
    );
}
