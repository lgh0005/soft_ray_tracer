//[수정] 신규 RTBVH 전용 PBR 셰이더: 텍스처 / 씬 조명 / GGX 직접광

#version 460 core

//[수정] C++ GPU 데이터 배치와 맞춘 구조체 직접 선언

struct GPUStaticVertex
{
    vec4 position;
    vec4 normal;
    vec4 uv;
};

struct GPUMeshDescriptor
{
    uint vertexOffset;
    uint vertexCount;
    uint triangleOffset;
    uint triangleCount;
    uint meshType;
    uint pad0;
    uint pad1;
    uint pad2;
};

struct GPUInstance
{
    mat4 worldMatrix;
    mat4 inverseWorldMatrix;

    uint meshIndex;
    uint materialIndex;
    uint boneOffset;
    uint boneCount;

    uint skinnedVertexOffset;
    uint blasBoundsOffset;
    uint pad1;
    uint pad2;
};

struct GPURTMaterial
{
    vec4 albedoFactor;
    vec4 emission;
    float metallicFactor;
    float roughnessFactor;
    float ior;
    float transmission;
    uint albedoTextureIndex;
    uint normalTextureIndex;
    uint aoTextureIndex;
    uint roughnessTextureIndex;
    uint emissionTextureIndex;
    uint reservedTextureIndex;
    uint metallicTextureIndex;
    uint specularTextureIndex;
};

layout(local_size_x = 64) in;

// ==================================================
// Constants
// ==================================================

const uint RAY_ACTIVE = 1u;

// 0: Primary Normal Debug
// 1: PBR Direct Lighting
// 2: Material Index Debug
const uint SHADING_MODE = 1u;

// Fixed-Point Accumulation
const float ACCUM_SCALE = 4096.0;
const float MAX_CONTRIBUTION = 1024.0;

// ==================================================
// Ray Structures
// ==================================================

struct GPURay
{
    vec4 origin;
    vec4 direction;
};

struct GPURayPayload
{
    vec4 throughput;

    uint pixelIndex;
    uint depth;
    uint flags;
    uint pad0;
};

struct GPURayWorkItem
{
    GPURay ray;
    GPURayPayload payload;
};

// ==================================================
// Hit Structure
// ==================================================

struct GPUHit
{
    // x: t
    // y: barycentric u
    // z: barycentric v
    vec4 intersection;

    // x: instanceID
    // y: globalTriangleID
    // z: hasHit
    uvec4 identifiers;
};

// ==================================================
// Geometry Structures
// ==================================================

const uint MESH_TYPE_SKINNED = 1u; // ERTMeshType::Skinned

layout(std430, binding = 15) readonly buffer MaterialBuffer
{
    GPURTMaterial materials[];
};

// ==================================================
// Accumulation Structure
// ==================================================

struct GPUAccumPixel
{
    uint r;
    uint g;
    uint b;
    uint pad0;
};

// ==================================================
// SSBO
// ==================================================

// Binding 0: Current Ray Queue
layout(std430, binding = 0) readonly buffer RayBuffer
{
    GPURayWorkItem rays[];
};

// Binding 1: Hit Buffer
layout(std430, binding = 1) readonly buffer HitBuffer
{
    GPUHit hits[];
};

// Binding 3: Static Vertex Buffer
layout(std430, binding = 3) readonly buffer VertexBuffer
{
    GPUStaticVertex vertices[];
};

// Binding 4: Triangle Index Buffer
layout(std430, binding = 4) readonly buffer IndexBuffer
{
    uint indices[];
};

// Binding 5: Mesh Descriptor Buffer
layout(std430, binding = 5) readonly buffer MeshBuffer
{
    GPUMeshDescriptor meshes[];
};

// Binding 6: Instance Buffer
layout(std430, binding = 6) readonly buffer InstanceBuffer
{
    GPUInstance instances[];
};

// Binding 9: Skinned Output Buffer
layout(std430, binding = 9) readonly buffer SkinnedOutputBuffer
{
    GPUStaticVertex outputVertices[];
};

// Binding 11: Current Ray Counter
layout(std430, binding = 11) readonly buffer RayCounterBuffer
{
    uint rayCount;
};

// Binding 14: Accumulation Buffer
layout(std430, binding = 14) buffer AccumulationBuffer
{
    GPUAccumPixel accumulation[];
};

// ==================================================
// Frame UBO
// ==================================================

layout(std140, binding = 1) uniform RTFrameData
{
    uint uPrimaryRayCount;
    uint uInstanceCount;
    uint uTLASDescriptorIndex;
    uint _pad1;
};

// ==================================================
// Atomic Accumulation
// ==================================================

void AccumulateRadiance(
    uint pixelIndex,
    vec3 radiance)
{
    if (pixelIndex >= uPrimaryRayCount)
        return;

    // Nonnegative radiance only
    vec3 value = clamp(
        radiance,
        vec3(0.0),
        vec3(MAX_CONTRIBUTION)
    );

    // Float -> Fixed-Point
    uvec3 encoded = uvec3(
        round(value * ACCUM_SCALE)
    );

    // Atomic accumulation
    atomicAdd(
        accumulation[pixelIndex].r,
        encoded.r
    );

    atomicAdd(
        accumulation[pixelIndex].g,
        encoded.g
    );

    atomicAdd(
        accumulation[pixelIndex].b,
        encoded.b
    );
}

// ==================================================
// World Normal
// ==================================================

vec3 GetWorldNormal(
    GPUHit hit,
    GPUInstance instance)
{
    GPUMeshDescriptor mesh =
        meshes[instance.meshIndex];

    // ClosestHit stores global triangle ID
    uint indexBase =
        hit.identifiers.y * 3u;

    uint i0 = indices[indexBase + 0u];
    uint i1 = indices[indexBase + 1u];
    uint i2 = indices[indexBase + 2u];

    vec3 n0;
    vec3 n1;
    vec3 n2;

    if (mesh.meshType == MESH_TYPE_SKINNED)
    {
        // GPU Skinned Mesh
        uint offset =
            instance.skinnedVertexOffset;

        n0 = outputVertices[offset + i0].normal.xyz;
        n1 = outputVertices[offset + i1].normal.xyz;
        n2 = outputVertices[offset + i2].normal.xyz;
    }
    else
    {
        // Static Mesh
        uint offset = mesh.vertexOffset;

        n0 = vertices[offset + i0].normal.xyz;
        n1 = vertices[offset + i1].normal.xyz;
        n2 = vertices[offset + i2].normal.xyz;
    }

    // Barycentric interpolation
    float u = hit.intersection.y;
    float v = hit.intersection.z;
    float w = 1.0 - u - v;

    vec3 localNormal = normalize(
        w * n0 +
        u * n1 +
        v * n2
    );

    // Local -> World Normal
    mat3 normalMatrix =
        transpose(mat3(instance.inverseWorldMatrix));

    return normalize(
        normalMatrix * localNormal
    );
}

// ==================================================
// Environment
// ==================================================

vec3 SampleEnvironment(vec3 rayDirection)
{
    vec3 direction = normalize(rayDirection);

    float t = clamp(
        direction.y * 0.5 + 0.5,
        0.0,
        1.0
    );

    vec3 horizon = vec3(0.55, 0.68, 0.80);
    vec3 zenith  = vec3(0.08, 0.18, 0.40);

    return mix(horizon, zenith, t);
}

// ==================================================
// PBR Direct Lighting
// ==================================================

// Scene lights use Rendering::LightData (std430 stride 160), separate from RT geometry bindings.
//[수정] C++ LightData와 배치를 맞춘 씬 조명 SSBO
struct LightData
{
    vec4 position;
    vec4 direction;
    vec4 color;
    float intensity;
    float range;
    float innerConeAngle;
    float outerConeAngle;
    uint type;
    float attenuationConstant;
    float attenuationLinear;
    float attenuationQuadratic;
    int shadowIndex;

    vec4 areaRight;
    vec4 areaUp;
    vec4 areaSize;
    uint lightFlags;
    uint pad0;
    uint pad1;
};
layout(std430, binding = 2) readonly buffer LightBuffer
{
    LightData lights[];
};

const float PI = 3.14159265359;
const float EPSILON = 0.0001;
const uint LIGHT_DIRECTIONAL = 0u;
const uint LIGHT_POINT = 1u;
const uint LIGHT_SPOT = 2u;
const uint LIGHT_RECT_AREA = 3u; // Area light integration is not implemented yet.
// GGX Normal Distribution
//[수정] GGX / Smith / Schlick 기반 직접광 BRDF
float DistributionGGX(vec3 N, vec3 H, float roughness)
{
    float safeRoughness = clamp(roughness, 0.045, 1.0);
    float a = safeRoughness * safeRoughness;
    float a2 = a * a;
    float NdotH = clamp(dot(N, H), 0.0, 1.0);
    float NdotH2 = NdotH * NdotH;
    float numerator = a2;
    // 작은 roughness의 피크를 보존하고 a2 - 1의 상쇄 오차를 피한다.
    float denominator = (1.0 - NdotH2) + a2 * NdotH2;
    return numerator / (PI * denominator * denominator);
}

// Schlick-GGX Geometry
float GeometrySchlickGGX(float NdotV, float roughness)
{
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return NdotV / max(NdotV * (1.0 - k) + k, EPSILON);
}

// Smith Geometry
float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    float NdotV = max(dot(N, V), 0.0);
    float NdotL = max(dot(N, L), 0.0);
    return GeometrySchlickGGX(NdotV, roughness)
         * GeometrySchlickGGX(NdotL, roughness);
}

// Schlick Fresnel
vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (1.0 - F0) * pow(1.0 - clamp(cosTheta, 0.0, 1.0), 5.0);
}

// Point / Spot 거리 감쇠
float CalculateAttenuation(LightData light, float distance)
{
    if (distance >= light.range)
        return 0.0;

    float denominator =
        light.attenuationConstant +
        light.attenuationLinear * distance +
        light.attenuationQuadratic * distance * distance;

    float attenuation = 1.0 / max(denominator, EPSILON);

    float rangeFactor = clamp
    (
        1.0 - distance / max(light.range, EPSILON),
        0.0,
        1.0
    );

    return attenuation * rangeFactor * rangeFactor;
}

//[수정] 방향광 / 점광 / 스포트광 및 IOR / Metallic / Roughness 반영
vec3 EvaluatePBRLight(LightData light, GPURTMaterial material, vec3 worldPosition, vec3 N, vec3 V)
{
    vec3 L;
    float attenuation = 1.0;
    if (light.type == LIGHT_DIRECTIONAL)
    {
        L = normalize(-light.direction.xyz);
    }
    else if (light.type == LIGHT_POINT || light.type == LIGHT_SPOT)
    {
        vec3 toLight = light.position.xyz - worldPosition;
        float distance = length(toLight);
        if (distance >= light.range || distance <= EPSILON) return vec3(0.0);
        L = toLight / distance;
        attenuation = CalculateAttenuation(light, distance);
        if (light.type == LIGHT_SPOT)
        {
            float theta = dot(-L, normalize(light.direction.xyz));
            float coneWidth = light.innerConeAngle - light.outerConeAngle;
            attenuation *= clamp((theta - light.outerConeAngle) / max(coneWidth, EPSILON), 0.0, 1.0);
        }
    }
    else return vec3(0.0);

    float NdotL = max(dot(N, L), 0.0);
    float NdotV = max(dot(N, V), 0.0);
    if (NdotL <= 0.0 || NdotV <= 0.0) return vec3(0.0);

    vec3 H = normalize(V + L);
    vec3 albedo = clamp(material.albedoFactor.rgb, vec3(0.0), vec3(1.0));
    float metallic = clamp(material.metallicFactor, 0.0, 1.0);
    float roughness = clamp(material.roughnessFactor, 0.045, 1.0);
    float transmission = clamp(material.transmission, 0.0, 1.0);
    float ior = max(material.ior, 0.001);
    float dielectricF0 = (ior - 1.0) / (ior + 1.0);
    dielectricF0 *= dielectricF0;
    vec3 F0 = mix(vec3(dielectricF0), albedo, metallic);

    float NDF = DistributionGGX(N, H, roughness);
    float G = GeometrySmith(N, V, L, roughness);
    vec3 F = FresnelSchlick(max(dot(H, V), 0.0), F0);
    vec3 specular = (NDF * G * F) / max(4.0 * NdotV * NdotL, EPSILON);
    vec3 kD = (vec3(1.0) - F) * (1.0 - metallic) * (1.0 - transmission);
    vec3 diffuse = kD * albedo / PI;
    vec3 radiance = light.color.rgb * light.intensity * attenuation;
    // Shadow visibility and IBL are separate stages; AO does not attenuate direct light.
    return (diffuse + specular) * radiance * NdotL;
}
// ==================================================
// Material Index Debug
// ==================================================

vec3 DebugMaterialIndex(uint materialID)
{
    // Color by table index, without assigning a material model to that index.
    uint hash = materialID * 1664525u + 1013904223u;
    return vec3(hash & 255u, (hash >> 8u) & 255u, (hash >> 16u) & 255u) / 255.0;
}

// ==================================================
// Main
// ==================================================

// Sampler indices need constant-index branches because rays access different materials.
//[수정] 머티리얼 텍스처 유닛과 비균일 접근용 상수 인덱스 분기
layout(binding = 0) uniform sampler2D uMaterialTextures[16];

vec4 SampleMaterialTexture(uint index, vec2 uv)
{
    switch (index)
    {
        case 0u: return textureLod(uMaterialTextures[0], uv, 0.0);
        case 1u: return textureLod(uMaterialTextures[1], uv, 0.0);
        case 2u: return textureLod(uMaterialTextures[2], uv, 0.0);
        case 3u: return textureLod(uMaterialTextures[3], uv, 0.0);
        case 4u: return textureLod(uMaterialTextures[4], uv, 0.0);
        case 5u: return textureLod(uMaterialTextures[5], uv, 0.0);
        case 6u: return textureLod(uMaterialTextures[6], uv, 0.0);
        case 7u: return textureLod(uMaterialTextures[7], uv, 0.0);
        case 8u: return textureLod(uMaterialTextures[8], uv, 0.0);
        case 9u: return textureLod(uMaterialTextures[9], uv, 0.0);
        case 10u: return textureLod(uMaterialTextures[10], uv, 0.0);
        case 11u: return textureLod(uMaterialTextures[11], uv, 0.0);
        case 12u: return textureLod(uMaterialTextures[12], uv, 0.0);
        case 13u: return textureLod(uMaterialTextures[13], uv, 0.0);
        case 14u: return textureLod(uMaterialTextures[14], uv, 0.0);
        case 15u: return textureLod(uMaterialTextures[15], uv, 0.0);
        default: return vec4(1.0);
    }
}

//[수정] 교차점 UV로 맵을 읽고 변형 삼각형 기준으로 Normal Map 적용
float ApplyRTTextures(GPUHit hit, GPUInstance instance, inout GPURTMaterial material, inout vec3 worldNormal)
{
    GPUMeshDescriptor mesh = meshes[instance.meshIndex];
    uint indexBase = hit.identifiers.y * 3u;
    uint i0 = indices[indexBase];
    uint i1 = indices[indexBase + 1u];
    uint i2 = indices[indexBase + 2u];
    GPUStaticVertex v0, v1, v2;
    if (mesh.meshType == MESH_TYPE_SKINNED)
    {
        uint offset = instance.skinnedVertexOffset;
        v0 = outputVertices[offset + i0];
        v1 = outputVertices[offset + i1];
        v2 = outputVertices[offset + i2];
    }
    else
    {
        uint offset = mesh.vertexOffset;
        v0 = vertices[offset + i0];
        v1 = vertices[offset + i1];
        v2 = vertices[offset + i2];
    }
    float u = hit.intersection.y;
    float v = hit.intersection.z;
    vec2 uv = (1.0 - u - v) * v0.uv.xy + u * v1.uv.xy + v * v2.uv.xy;
    material.albedoFactor *= SampleMaterialTexture(material.albedoTextureIndex, uv);
    material.roughnessFactor *= SampleMaterialTexture(material.roughnessTextureIndex, uv).r;
    material.metallicFactor *= SampleMaterialTexture(material.metallicTextureIndex, uv).r;
    material.emission.rgb *= SampleMaterialTexture(material.emissionTextureIndex, uv).rgb;
    float ao = SampleMaterialTexture(material.aoTextureIndex, uv).r;

    if (material.normalTextureIndex != 0xffffffffu)
    {
        vec2 duv1 = v1.uv.xy - v0.uv.xy;
        vec2 duv2 = v2.uv.xy - v0.uv.xy;
        float determinant = duv1.x * duv2.y - duv1.y * duv2.x;
        if (abs(determinant) > 1e-8)
        {
            vec3 e1 = mat3(instance.worldMatrix) * (v1.position.xyz - v0.position.xyz);
            vec3 e2 = mat3(instance.worldMatrix) * (v2.position.xyz - v0.position.xyz);
            vec3 tangent = (e1 * duv2.y - e2 * duv1.y) / determinant;
            vec3 bitangent = (e2 * duv1.x - e1 * duv2.x) / determinant;
            tangent -= worldNormal * dot(worldNormal, tangent);
            if (dot(tangent, tangent) > 1e-12)
            {
                tangent = normalize(tangent);
                float handedness = dot(cross(worldNormal, tangent), bitangent) < 0.0 ? -1.0 : 1.0;
                bitangent = handedness * cross(worldNormal, tangent);
                // BC5 and RGB normal maps share XY; reconstruct Z as in the raster path.
                vec2 xy = SampleMaterialTexture(material.normalTextureIndex, uv).rg * 2.0 - 1.0;
                vec3 normal = vec3(xy, sqrt(max(1.0 - dot(xy, xy), 0.0)));
                worldNormal = normalize(mat3(tangent, bitangent, worldNormal) * normal);
            }
        }
    }
    return clamp(ao, 0.0, 1.0);
}

void main()
{
    // 1. Current Ray Queue Index
    uint rayIndex = gl_GlobalInvocationID.x;

    if (rayIndex >= rayCount)
        return;

    // 2. Current Ray
    GPURayWorkItem ray = rays[rayIndex];

    if ((ray.payload.flags & RAY_ACTIVE) == 0u)
        return;

    // 3. Original Pixel
    uint pixelIndex = ray.payload.pixelIndex;

    if (pixelIndex >= uPrimaryRayCount)
        return;

    // 4. Debug Modes: Primary Ray Only
    if (SHADING_MODE != 1u &&
        ray.payload.depth != 0u)
    {
        return;
    }

    // 5. Hit Result
    GPUHit hit = hits[rayIndex];

    vec3 radiance = vec3(0.0);

    // ==================================================
    // Miss
    // ==================================================

    if (hit.identifiers.z == 0u)
    {
        if (SHADING_MODE == 1u)
        {
            radiance = SampleEnvironment(
                ray.ray.direction.xyz
            );
        }
    }
    // ==================================================
    // Surface Hit
    // ==================================================
    else
    {
        GPUInstance instance =
            instances[hit.identifiers.x];

        uint materialID = instance.materialIndex;
        GPURTMaterial material = materials[materialID];

        // ==============================================
        // Material Index Debug
        // ==============================================

        if (SHADING_MODE == 2u)
        {
            radiance = DebugMaterialIndex(materialID);
        }
        else
        {
            vec3 worldNormal =
                GetWorldNormal(hit, instance);
            ApplyRTTextures(hit, instance, material, worldNormal);

            // ==========================================
            // Normal Debug
            // ==========================================

            if (SHADING_MODE == 0u)
            {
                radiance =
                    worldNormal * 0.5 + 0.5;
            }
            // ==========================================
            // PBR Direct Lighting
            // ==========================================

            else
            {
                //[수정] Hit 위치를 복원하고 활성 씬 조명의 PBR 직접광 누적
                vec3 worldPosition = ray.ray.origin.xyz + ray.ray.direction.xyz * hit.intersection.x;
                vec3 V = normalize(-ray.ray.direction.xyz);
                vec3 N = dot(worldNormal, V) < 0.0 ? -worldNormal : worldNormal;
                radiance = max(material.emission.rgb, vec3(0.0));
                // The bound SSBO range contains only the current frame's lights.
                for (uint i = 0u; i < uint(lights.length()); ++i)
                    radiance += EvaluatePBRLight(lights[i], material, worldPosition, N, V);
            }
        }
    }

    // ==================================================
    // Apply Throughput
    // ==================================================

    vec3 contribution =
        ray.payload.throughput.rgb * radiance;

    // ==================================================
    // Accumulate Radiance
    // ==================================================

    AccumulateRadiance(
        pixelIndex,
        contribution
    );
}
