
#version 460 core

layout(local_size_x = 8, local_size_y = 8) in;

// ==================================================
// Constants
// ==================================================

// RTShadingPass와 동일한 Accumulation Scale
const float ACCUM_SCALE = 4096.0;
const float INV_ACCUM_SCALE = 1.0 / ACCUM_SCALE;

// ==================================================
// Accumulation Structure
// ==================================================

struct GPUAccumPixel
{
    uint r;
    uint g;
    uint b;
    uint pad0;
};

// ==================================================
// SSBO
// ==================================================

// Binding 14: Pixel Accumulation
layout(std430, binding = 14) readonly buffer AccumulationBuffer
{
    GPUAccumPixel accumulation[];
};

// ==================================================
// Output Image
// ==================================================

layout(rgba16f, binding = 0)
uniform writeonly image2D outputImage;

// ==================================================
// Main
// ==================================================

void main()
{
    // 1. Pixel Coordinates
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 resolution = imageSize(outputImage);

    // 2. Bounds Check
    if (pixel.x >= resolution.x ||
        pixel.y >= resolution.y)
    {
        return;
    }

    // 3. Pixel Index
    uint pixelIndex =
        uint(pixel.y) * uint(resolution.x) +
        uint(pixel.x);

    // 4. Read Accumulation Buffer
    GPUAccumPixel value = accumulation[pixelIndex];

    // 5. Fixed-Point -> Floating-Point
    vec3 radiance = vec3(
        float(value.r),
        float(value.g),
        float(value.b)
    ) * INV_ACCUM_SCALE;

    // [TEMP] 후처리 패스 연결 전까지 노출 1.0의 톤 매핑과 감마 보정 적용
    const float exposure = 1.0;
    const float gamma = 2.2;
    vec3 displayColor = vec3(1.0) - exp(-max(radiance, vec3(0.0)) * exposure);
    displayColor = pow(displayColor, vec3(1.0 / gamma));

    // [TEMP] 현재는 HDR 대신 표시용 색상을 저장
    imageStore(
        outputImage,
        pixel,
        vec4(displayColor, 1.0)
    );
}
