#version 460 core
layout(local_size_x = 8, local_size_y = 8) in;

struct Guide
{
    vec4 position;
    vec4 normal;
    vec4 previousPosition;
    uvec4 ids;
};
layout(std430, binding = 0) readonly buffer CurrentGuide { Guide guides[]; };
layout(std430, binding = 1) readonly buffer PreviousGuide { Guide oldGuides[]; };
layout(rgba32f, binding = 0) uniform readonly image2D currentHDR;
layout(rgba32f, binding = 1) uniform readonly image2D previousHDR;
layout(rgba32f, binding = 2) uniform writeonly image2D nextHDR;
uniform mat4 previousVP;
uniform uint resetHistory;
uniform uint progressive;
uniform uint historyLimit;

void main()
{
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(currentHDR);
    if (any(greaterThanEqual(p, size))) return;
    Guide g = guides[p.y * size.x + p.x];
    vec3 color = imageLoad(currentHDR, p).xyz;
    if (any(isnan(color)) || any(isinf(color))) color = vec3(0.0);
    float historyLength = 1.0;
    vec3 result = color;
    if (resetHistory == 0u && g.ids.z != 0u)
    {
        vec4 clip = previousVP * g.previousPosition;
        vec2 uv = clip.xy / max(clip.w, 1e-8) * 0.5 + 0.5;
        bool inside = clip.w > 0.0 && all(greaterThanEqual(uv, vec2(0.0))) && all(lessThan(uv, vec2(1.0)));
        ivec2 oldPixel = ivec2(uv * vec2(size));
        if (inside)
        {
            Guide old = oldGuides[oldPixel.y * size.x + oldPixel.x];
            float tolerance = max(0.003, 0.005 * abs(clip.w));
            bool valid = old.ids.z != 0u && all(equal(old.ids.xy, g.ids.xy)) &&
                distance(old.position.xyz, g.previousPosition.xyz) < tolerance &&
                dot(normalize(old.normal.xyz), normalize(g.normal.xyz)) > 0.9;
            if (valid)
            {
                vec4 history = imageLoad(previousHDR, oldPixel);
                if (!any(isnan(history)) && !any(isinf(history)))
                {
                    vec3 previous = history.xyz;
                    float limit = float(historyLimit);
                    if (progressive == 0u)
                    {
                        vec3 low = vec3(3.402823466e38);
                        vec3 high = vec3(-3.402823466e38);
                        for (int y = -1; y <= 1; ++y)
                        {
                            for (int x = -1; x <= 1; ++x)
                            {
                                ivec2 n = clamp(p + ivec2(x, y), ivec2(0), size - 1);
                                vec3 c = imageLoad(currentHDR, n).xyz;
                                low = min(low, c);
                                high = max(high, c);
                            }
                        }
                        previous = clamp(previous, low, high);
                        if (g.normal.w < 0.2) limit = min(limit, 4.0);
                    }
                    historyLength = min(history.w + 1.0, limit);
                    result = mix(previous, color, 1.0 / max(historyLength, 1.0));
                }
            }
        }
    }
    imageStore(nextHDR, p, vec4(max(result, vec3(0.0)), historyLength));
}
