#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rg16f, binding = 0) writeonly uniform image2D uOutput;

uniform int uSize;
uniform int uSamples;

const float PI = 3.14159265358979323846;
const float EPSILON = 0.00001;

float RadicalInverse(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 Hammersley(uint index, uint count)
{
    return vec2(float(index) / float(count), RadicalInverse(index));
}

vec3 ImportanceSampleGGX(vec2 xi, float roughness)
{
    float alpha = roughness * roughness;
    float phi = 2.0 * PI * xi.x;
    float cosTheta = sqrt((1.0 - xi.y) / (1.0 + (alpha * alpha - 1.0) * xi.y));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    return vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);
}

float GeometrySchlickGGX(float NdotDirection, float roughness)
{
    // IBL용 k. 직접광의 (roughness + 1)^2 / 8과 구분한다.
    float k = roughness * roughness * 0.5;
    return NdotDirection / max(NdotDirection * (1.0 - k) + k, EPSILON);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= uSize || pixel.y >= uSize) return;

    // LUT 좌표: x=NdotV, y=roughness. 텍셀 중심에서 적분한다.
    vec2 uv = (vec2(pixel) + 0.5) / float(uSize);
    float NdotV = clamp(uv.x, 0.001, 1.0);
    float roughness = clamp(uv.y, 0.001, 1.0);
    vec3 V = vec3(sqrt(max(0.0, 1.0 - NdotV * NdotV)), 0.0, NdotV);

    uint sampleCount = uint(max(uSamples, 1));
    vec2 integrated = vec2(0.0);

    for (uint i = 0u; i < sampleCount; ++i)
    {
        // N=(0,0,1)이므로 tangent-space H를 그대로 사용한다.
        vec3 H = ImportanceSampleGGX(Hammersley(i, sampleCount), roughness);
        vec3 L = normalize(2.0 * dot(V, H) * H - V);
        float NdotL = max(L.z, 0.0);
        if (NdotL <= 0.0) continue;

        float NdotH = max(H.z, 0.0);
        float VdotH = clamp(dot(V, H), 0.0, 1.0);
        float G = GeometrySchlickGGX(NdotV, roughness) * GeometrySchlickGGX(NdotL, roughness);
        float visibility = (G * VdotH) / max(NdotH * NdotV, EPSILON);
        float fresnel = pow(1.0 - VdotH, 5.0);
        integrated += vec2(1.0 - fresnel, fresnel) * visibility;
    }

    // R=A, G=B. 소비 셰이더: prefiltered * (F0 * A + B).
    imageStore(uOutput, pixel, vec4(integrated / float(sampleCount), 0.0, 1.0));
}
